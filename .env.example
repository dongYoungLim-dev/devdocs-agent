# 실행 프로필: onprem | saas | hybrid (config/profiles.yaml)
PROFILE=onprem

# 로컬 모델 (Ollama OpenAI 호환 API)
OLLAMA_BASE_URL=http://localhost:11434/v1

# 클라우드 모델 (saas·hybrid 프로필에서만 사용)
ANTHROPIC_API_KEY=

# 관측 (Langfuse 클라우드)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# DB (docker-compose 의 pgvector)
DATABASE_URL=postgresql://devdocs:devdocs@localhost:5432/devdocs

# API 인증 키
API_KEY=

# 이슈 생성 도구 (비우면 dry-run)
GITHUB_TOKEN=

# 코퍼스 설정·평가셋·결과를 두는 저장소 밖 디렉터리
PRIVATE_DIR=
